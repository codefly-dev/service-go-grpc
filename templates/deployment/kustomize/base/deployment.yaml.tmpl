apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Service.Name.DNSCase }}
  namespace: {{ .Namespace }}
spec:
  replicas: {{ .Replicas }}
  selector:
    matchLabels:
      app: {{ .Service.Name.DNSCase }}
  template:
    metadata:
      labels:
        app: {{ .Service.Name.DNSCase }}
        sha: {{ .Sha }}
{{- with .Deployment.Parameters }}{{- if .Name }}
{{- range $key, $value := .Labels }}
        {{ $key }}: {{ $value | quote }}
{{- end }}
{{- end }}{{- end }}
    spec:
{{- with .Deployment.Parameters }}{{- if .Name }}
      serviceAccountName: {{ .Name }}
{{- end }}{{- end }}
      # uid 65532 = nobody/nogroup in distroless and most scratch
      # base images. The codefly Go Dockerfile template (BuildGoDocker
      # in core/runners/golang) produces a static binary on alpine,
      # which has uid 65534 for nobody. Use 65534 to match.
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        fsGroup: 65534
        seccompProfile:
          type: RuntimeDefault
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      containers:
        - name: {{ .Service.Name.DNSCase }}
          image: {{ .Image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 65534
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
          ports:
            # Match service.yaml.tmpl. http is grpc-gateway (REST
            # facade), grpc is the raw gRPC listener.
            - name: http
              containerPort: 8080
            - name: grpc
              containerPort: 9090
          envFrom:
            - configMapRef:
                name: cm-{{ .Service.Name.DNSCase }}
{{- if not .Restricted }}
            - secretRef:
                name: secret-{{ .Service.Name.DNSCase }}
{{- end }}
{{- if .Restricted }}
          env:
{{- range $key, $reference := .SecretReferences }}
            - name: {{ $key }}
              valueFrom:
                secretKeyRef:
                  name: {{ $reference.Name }}
                  key: {{ $reference.Key }}
{{- end }}
{{- end }}
          # Conservative defaults — bump per-service in overlay when
          # workload size is known.
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 512Mi
          # The generic deployment contract guarantees the listener,
          # not a product-specific HTTP health route.
          startupProbe:
            tcpSocket:
              port: http
            periodSeconds: 2
            failureThreshold: 30
          readinessProbe:
            tcpSocket:
              port: http
            periodSeconds: 5
            timeoutSeconds: 3
          livenessProbe:
            tcpSocket:
              port: http
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
          # readOnlyRootFilesystem=true means anything that wants to
          # write needs an explicit volume. /tmp is the classic one;
          # add more here if a service needs scratch space.
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
