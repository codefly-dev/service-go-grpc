{{- define "execProbeHandler" }}
            exec:
              command: [{{ range $i, $arg := . }}{{ if $i }}, {{ end }}{{ printf "%q" $arg }}{{ end }}]
{{- end }}
{{- define "healthProbeHandler" }}
{{- $mode := .Health.Handler }}
{{- if .PersistentLoopback }}
{{- template "execProbeHandler" .PersistentLoopback.Readiness }}
{{- else }}
{{- if eq $mode "grpc" }}
            grpc:
              port: {{ .RPCPort }}
{{- with .Health.GrpcService }}
              service: {{ . | quote }}
{{- end }}
{{- else if eq $mode "http" }}
            httpGet:
              path: {{ .Health.Path | quote }}
              port: {{ .Health.Port }}
{{- else }}
            tcpSocket:
              port: {{ .RPCPortName }}
{{- end }}
{{- end }}
{{- end }}
{{- $health := .Deployment.Parameters -}}
{{- $persistent := $health.PersistentLoopback -}}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Service.Name.DNSCase }}
  namespace: {{ .Namespace }}
spec:
{{- if $persistent }}
  replicas: 1
  strategy:
    type: Recreate
{{- else }}
  replicas: {{ .Replicas }}
{{- end }}
  selector:
    matchLabels:
      app: {{ .Service.Name.DNSCase }}
  template:
    metadata:
      labels:
        app: {{ .Service.Name.DNSCase }}
        sha: {{ .Sha }}
{{- with .Deployment.Parameters.ServiceAccount }}{{- if .Name }}
{{- range $key, $value := .Labels }}
        {{ $key }}: {{ $value | quote }}
{{- end }}
{{- end }}{{- end }}
    spec:
{{- with .Deployment.Parameters.ServiceAccount }}{{- if .Name }}
      serviceAccountName: {{ .Name }}
{{- end }}{{- end }}
      # uid 65532 = nobody/nogroup in distroless and most scratch
      # base images. The codefly Go Dockerfile template (BuildGoDocker
      # in core/runners/golang) produces a static binary on alpine,
      # which has uid 65534 for nobody. Use 65534 to match.
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ if $persistent }}{{ $persistent.UID }}{{ else }}65534{{ end }}
        runAsGroup: {{ if $persistent }}{{ $persistent.GID }}{{ else }}65534{{ end }}
        fsGroup: {{ if $persistent }}{{ $persistent.GID }}{{ else }}65534{{ end }}
        seccompProfile:
          type: RuntimeDefault
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      containers:
        - name: {{ .Service.Name.DNSCase }}
          image: {{ .Image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: {{ if $persistent }}{{ $persistent.UID }}{{ else }}65534{{ end }}
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
{{- if not $persistent }}
          ports:
            # Match service.yaml.tmpl. grpc is omitted for Connect-only
            # services. http (grpc-gateway REST facade) and connect are advertised
            # whenever something binds them — the agent's scaffold, OR the
            # service's own listener for an endpoint it declares and owns — on
            # the port Codefly resolved. Advertise a port only when the process
            # binds it, so nothing routes to a dead port, and advertise every
            # port it does bind, so nothing resolves an address that answers
            # nothing.
{{- if not .Deployment.Parameters.ConnectOnly }}
            - name: grpc
              containerPort: 9090
{{- end }}
{{- with .Deployment.Parameters.RestPort }}
            - name: http
              containerPort: {{ . }}
{{- end }}
{{- with .Deployment.Parameters.ConnectPort }}
            - name: connect
              containerPort: {{ . }}
{{- end }}
{{- range .Deployment.Parameters.NamedPorts }}
            # A named endpoint's listener, on the port Codefly resolved for it.
            - containerPort: {{ .Port }}
{{- end }}
{{- end }}
          envFrom:
            - configMapRef:
                name: cm-{{ .Service.Name.DNSCase }}
{{- if not .Restricted }}
            - secretRef:
                name: secret-{{ .Service.Name.DNSCase }}
{{- end }}
{{- if .Restricted }}
          env:
{{- range $key, $reference := .SecretReferences }}
            - name: {{ $key }}
              valueFrom:
                secretKeyRef:
                  name: {{ $reference.Name }}
                  key: {{ $reference.Key }}
{{- end }}
{{- end }}
          # Conservative defaults — bump per-service in overlay when
          # workload size is known.
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 512Mi
          # Startup and readiness speak the health contract the service
          # declares (spec.health), never one this agent invented: a route or a
          # listener the process does not serve fails forever and the kubelet
          # restart-loops the pod. Undeclared means transport-only, so a
          # service customized before semantic health existed keeps the probes
          # it has always had.
          startupProbe:
{{- template "healthProbeHandler" $health }}
            periodSeconds: 2
            failureThreshold: 30
          readinessProbe:
{{- template "healthProbeHandler" $health }}
            periodSeconds: 5
            timeoutSeconds: 3
          # Liveness stays transport-only whatever health the service declares.
          # It answers "is this process wedged", never "is a dependency
          # reachable": a service that reports NOT_SERVING because something
          # downstream is unavailable must drop out of load balancing, not be
          # restarted — restarting it cascades an outage across every consumer.
          livenessProbe:
{{- if $persistent }}
{{- template "execProbeHandler" $persistent.Liveness }}
{{- else }}
            tcpSocket:
              port: {{ .Deployment.Parameters.RPCPortName }}
{{- end }}
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
          # readOnlyRootFilesystem=true means anything that wants to
          # write needs an explicit volume. /tmp is the classic one;
          # add more here if a service needs scratch space.
          volumeMounts:
            - name: tmp
              mountPath: /tmp
{{- if $persistent }}
            - name: state
              mountPath: {{ $persistent.MountPath | quote }}
{{- end }}
      volumes:
        - name: tmp
          emptyDir: {}
{{- if $persistent }}
        - name: state
          persistentVolumeClaim:
            claimName: {{ .Service.Name.DNSCase }}-state
{{- end }}
