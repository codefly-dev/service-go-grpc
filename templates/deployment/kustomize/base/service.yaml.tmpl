apiVersion: v1
kind: Service
metadata:
  name: {{ .Service.Name.DNSCase }}
  namespace: {{ .Namespace }}
spec:
  selector:
    app: {{ .Service.Name.DNSCase}}
  ports:
{{- if not .Deployment.Parameters.ConnectOnly }}
    - protocol: TCP
      name: grpc-port
      port: 9090
      targetPort: 9090
{{- end }}
{{- with .Deployment.Parameters.RestPort }}
    - protocol: TCP
      name: http-port
      # The generated REST listener is a plain http.Server: HTTP/1.1 only. It
      # refuses prior-knowledge HTTP/2, so declaring http2 here would break
      # every REST call through an L7 hop that honours it.
      appProtocol: http
      port: {{ . }}
      targetPort: {{ . }}
{{- end }}
{{- with .Deployment.Parameters.ConnectPort }}
    - protocol: TCP
      name: connect-port
      # The Connect listener is h2c.NewHandler: it carries native gRPC over
      # cleartext HTTP/2 beside Connect and gRPC-Web. The name declares no
      # protocol, so an L7 hop needs this to keep that HTTP/2 upstream.
      appProtocol: http2
      port: {{ . }}
      targetPort: {{ . }}
{{- end }}
{{- range .Deployment.Parameters.NamedPorts }}
    - protocol: TCP
      name: {{ .Name }}
{{- with .AppProtocol }}
      appProtocol: {{ printf "%q" . }}
{{- end }}
      port: {{ .Port }}
      targetPort: {{ .Port }}
{{- end }}
