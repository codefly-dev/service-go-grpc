apiVersion: v1
kind: Service
metadata:
  name: {{ .Service.Name.DNSCase }}
  namespace: {{ .Namespace }}
spec:
  selector:
    app: {{ .Service.Name.DNSCase}}
  ports:
    - protocol: TCP
      name: grpc-port
      port: 9090
      targetPort: 9090
{{- with .Deployment.Parameters.RestPort }}
    - protocol: TCP
      name: http-port
      port: {{ . }}
      targetPort: {{ . }}
{{- end }}
{{- with .Deployment.Parameters.ConnectPort }}
    - protocol: TCP
      name: connect-port
      # The Connect listener is h2c.NewHandler: it carries native gRPC over
      # cleartext HTTP/2 beside Connect and gRPC-Web. The name declares no
      # protocol, so an L7 hop needs this to keep that HTTP/2 upstream.
      appProtocol: kubernetes.io/h2c
      port: {{ . }}
      targetPort: {{ . }}
{{- end }}
{{- range .Deployment.Parameters.NamedPorts }}
    - protocol: TCP
      name: {{ .Name }}
      port: {{ .Port }}
      targetPort: {{ .Port }}
{{- end }}
