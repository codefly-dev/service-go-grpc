{{- with .Deployment.Parameters.PersistentLoopback }}
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ $.Service.Name.DNSCase }}-state
  namespace: {{ $.Namespace }}
spec:
  accessModes:
    - ReadWriteOncePod
{{- with .StorageClass }}
  storageClassName: {{ . | quote }}
{{- end }}
  resources:
    requests:
      storage: {{ .Storage | quote }}
{{- end }}
