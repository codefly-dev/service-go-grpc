	if config.servesConnect() {
		conn, err = NewConnectServer(config, grpc.gRPC)
		if err != nil {
			return nil, err
		}
	}

	return &Server{
		grpc:    grpc,
{{- if .Settings.RestEndpoint }}
		rest:    rest,
{{- end }}
		connect: conn,
	}, nil
}

